DATABASE_URL="file:./dev.db"
# Local inference services. Empty means not configured; the UI offers a clearly labeled demo chat.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"
COMFYUI_BASE_URL="http://127.0.0.1:8188"
# Exact installed ComfyUI checkpoint filename. Required for image generation.
COMFYUI_CHECKPOINT=""
# Optional absolute path to a ComfyUI API-format workflow using documented placeholders.
COMFYUI_WORKFLOW_PATH=""
# Set true when serving exclusively over HTTPS behind a trusted reverse proxy.
COOKIE_SECURE="false"
