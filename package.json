{
  "name": "private-companion",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node --require ./scripts/local-env.cjs ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "prisma generate && node --require ./scripts/local-env.cjs ./node_modules/next/dist/bin/next build",
    "start": "node --require ./scripts/local-env.cjs ./node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "db:deploy": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "test:integrations": "playwright test --config playwright.integrations.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
